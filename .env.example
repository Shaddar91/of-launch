# Local development values. Copy to .env (git-ignored); replace CHANGEME outside the repository.
MOCK_MODE=true
FLASK_DEBUG=false
GUNICORN_WORKERS=2
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=localdevpass
DB_NAME=deployment_app
TABLE_NAME_USERS=users
TABLE_NAME_DEPLOYMENTS=deployments
APP_USER=admin
APP_PASSWORD=admin
APP_USER_ROLE=admin
APP_SECRET_KEY=local-dev-secret-key-not-for-prod
SEED_USERS=
PER_PAGE_DEFAULT=10
MAX_RECORDS=100
OF_CLUSTERS_CONFIG_PATH=config/clusters.json
OF_ARTIFACT_BUCKET=CHANGEME
OF_WEB_DEPLOY_BUCKET=CHANGEME
OF_WEB_CLOUDFRONT_ID=CHANGEME
OF_GITHUB_OWNER=CHANGEME
OF_SHARED_EXECUTOR_ENVIRONMENTS=
OF_SLACK_WEBHOOK_URL=
OF_DISPLAY_TIMEZONE=Europe/Berlin
OF_BATCH_STORE_DIR=/tmp/of-launch-batches
OF_CODEDEPLOY_POLL_INTERVAL_SECONDS=20
OF_CODEDEPLOY_POLL_TIMEOUT_SECONDS=1800
OF_DEPLOY_FIRST_SETTLE_SECONDS=60
OF_REGION=us-east-1
ARGOCD_OF_URL=
ARGOCD_OF_TOKEN=
GITHUB_TOKEN=
